# Copy to .env.local for local development; set the same values in your host's
# environment for production. Every variable here is optional — the site builds
# and serves without them, with the matching feature disabled.

# Ask AI, the in-page assistant. Routed through the Vercel AI Gateway, so one
# key covers every model (`anthropic/claude-sonnet-4-5` is configured).
# In production this is a Cloudflare Worker secret, not a build-time variable:
# the deploy workflow syncs it from the AI_GATEWAY_API_KEY repository secret, or
# set it by hand with
#   pnpm cf secret put AI_GATEWAY_API_KEY --config dist/server/wrangler.json
# (`pnpm cf` is this repo's account-scoped wrangler — see .env.cloudflare.example.)
AI_GATEWAY_API_KEY=

# Canonical origin, for absolute URLs: llms.txt links, MCP install snippets,
# agent-readability.json, sitemap, OG images. Production defaults to
# https://alzheimers.dev in blume.config.ts — set this only to point a
# mirror, fork, or preview build somewhere else.
# BLUME_SITE=https://docs.example.com

# Web Bot Auth: the PUBLIC half of an Ed25519 JWK, published at
# /.well-known/http-message-signatures-directory so sites receiving requests
# from this org's agents can verify them. Public keys only — a JWK containing
# private material fails the build. Generate a pair with:
#   node -e 'const { generateKeyPairSync } = require("node:crypto"); const { publicKey, privateKey } = generateKeyPairSync("ed25519"); console.log("public: ", JSON.stringify(publicKey.export({ format: "jwk" }))); console.log("private:", JSON.stringify(privateKey.export({ format: "jwk" })))'
# WEB_BOT_AUTH_PUBLIC_JWK={"kty":"OKP","crv":"Ed25519","x":"…"}
