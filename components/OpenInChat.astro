};

const items = providers.map((key) => ({
  href: CHAT_URLS[key](query),
  key,
  logo: LOGOS[key],
  name: NAMES[key],
}));

const primaryButton =
  "inline-flex h-8 cursor-pointer items-center rounded-lg bg-accent px-3.5 font-medium text-accent-foreground text-xs transition hover:bg-accent/90";
const triggerButton =
  "inline-flex h-8 cursor-pointer list-none items-center gap-1.5 rounded-lg border border-border bg-background px-3.5 font-medium text-muted-foreground text-xs transition hover:border-accent hover:text-accent [&::-webkit-details-marker]:hidden";
// `no-underline!` because MDX content sits inside prose, whose link rule wins
// on source order otherwise — a menu row is a control, not a link in a
// sentence.
const menuRowClass =
  "flex w-full items-center gap-2.5 rounded-md px-2 py-1.5 text-start text-muted-foreground text-sm no-underline! transition-colors hover:bg-muted hover:text-foreground";
---

<blume-open-in-chat
  class="not-prose my-6 block rounded-blume border border-border bg-muted/30"
  data-prompt={text}
>
  <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
    {
      description && (
        <p class="m-0! text-foreground text-sm" data-open-in-chat-description>
          {description}
        </p>
      )
    }
    <div class="flex shrink-0 items-center gap-2">
      <button
        aria-label="Copy prompt"
        class={primaryButton}
        data-open-in-chat-copy
        type="button"
      >
        {/* Both labels share one grid cell so swapping to "Copied" can't
            resize the button and shift the row beside it. */}
        <span class="grid *:col-start-1 *:row-start-1 *:text-center">
          <span data-open-in-chat-copy-idle>Copy prompt</span>
          <span
            aria-hidden="true"
            class="invisible"
            data-open-in-chat-copy-done>Copied</span
          >
        </span>
      </button>
      <details class="relative" data-open-in-chat-menu>
        <summary aria-label={label} class={triggerButton}>
          <Icon name="sparkles" size={14} />
          <span>{label}</span>
          <Icon name="chevron-down" size={13} />
        </summary>
        <div
          class="absolute end-0 z-50 mt-2 w-52 rounded-blume border border-border bg-background p-1 shadow-lg"
        >
          {
            items.map((item) => (
              <a
                class={menuRowClass}
                href={item.href}
                rel="noreferrer"
                target="_blank"
              >
                <Fragment set:html={item.logo} />
                <span class="flex-1">Open in {item.name}</span>
                <Icon name="external-link" size={13} />
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </div>
  {/* The prompt itself: hidden from readers, but present in the DOM so the
      copy button and any page-reading agent can pick it up verbatim. */}
  <div data-open-in-chat-prompt hidden><slot /></div>
</blume-open-in-chat>

<script>
  class BlumeOpenInChat extends HTMLElement {
    connectedCallback() {
      const prompt = this.dataset.prompt ?? "";

      const copy = this.querySelector<HTMLButtonElement>(
        "[data-open-in-chat-copy]"
      );
      const idle = copy?.querySelector<HTMLElement>(
        "[data-open-in-chat-copy-idle]"
      );
      const done = copy?.querySelector<HTMLElement>(
        "[data-open-in-chat-copy-done]"
      );
      copy?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(prompt);
        } catch {
          return;
        }
        idle?.classList.add("invisible");
        done?.classList.remove("invisible");
        setTimeout(() => {
          idle?.classList.remove("invisible");
          done?.classList.add("invisible");
        }, 1500);
      });

      // A <details> menu stays open until it's clicked again; close it on an
      // outside click or Escape the way a real menu behaves.
      const menu = this.querySelector<HTMLDetailsElement>(
        "[data-open-in-chat-menu]"
      );
      if (!menu) {
        return;
      }
      document.addEventListener("click", (event) => {
        if (menu.open && !menu.contains(event.target as Node)) {
          menu.open = false;
        }
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          menu.open = false;
        }
      });
    }
  }

  if (!customElements.get("blume-open-in-chat")) {
    customElements.define("blume-open-in-chat", BlumeOpenInChat);
  }
</script>
