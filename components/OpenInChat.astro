---
/**
 * Open in chat — an inline, MDX-usable version of the page action, modeled on
 * AI Elements' `<OpenIn />` (https://elements.ai-sdk.dev/components/open-in-chat):
 * one trigger that fans out to ChatGPT, Claude, T3 Chat, Scira, v0, and Cursor,
 * each pre-filled with the same prompt.
 *
 * Blume's built-in "Open in chat" action always sends the *current page*. This
 * component sends a prompt you choose — so a landing page can hand an agent the
 * whole corpus (`llms.txt`) or a scoped starter question, not just the page the
 * reader happens to be on.
 *
 * The prompt is the component's children (like the built-in `<Prompt>`), so it
 * can be written as ordinary MDX text. Links are built at render time — no
 * client JavaScript is needed to open a chat; the small script only powers the
 * copy button and the click-outside dismissal.
 */
import Icon from "blume/components/Icon.astro";

interface Props {
  /** Visible label beside the buttons. Plain text; keep it short. */
  description?: string;
  /** Prompt text, when you'd rather pass it as a prop than as children. */
  prompt?: string;
  /** Which assistants to offer, in menu order. */
  providers?: ProviderKey[];
  /** Label on the dropdown trigger. */
  label?: string;
}

type ProviderKey = "claude" | "chatgpt" | "cursor" | "codex" | "t3" | "scira" | "v0";

const {
  description,
  prompt,
  providers = ["claude", "chatgpt", "cursor", "t3", "scira", "v0"],
  label = "Open in chat",
} = Astro.props;

/**
 * Children arrive as rendered HTML (MDX has already run), so recover the plain
 * text an assistant should receive: drop tags, collapse whitespace, and decode
 * the handful of entities the Markdown pipeline emits.
 */
const toText = (html: string): string =>
  html
    .replace(/<[^>]+>/g, "")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&amp;/g, "&")
    .replace(/\s+/g, " ")
    .trim();

const slotHtml = Astro.slots.has("default")
  ? await Astro.slots.render("default")
  : "";
const text = (prompt ?? toText(slotHtml)).trim();
const query = encodeURIComponent(text);

/** Same URL shapes the built-in page action uses, so behavior matches. */
const CHAT_URLS: Record<ProviderKey, (q: string) => string> = {
  chatgpt: (q) => `https://chatgpt.com/?hints=search&prompt=${q}`,
  claude: (q) => `https://claude.ai/new?q=${q}`,
  codex: (q) => `https://chatgpt.com/codex?prompt=${q}`,
  cursor: (q) => `https://cursor.com/link/prompt?text=${q}`,
  scira: (q) => `https://scira.ai/?q=${q}`,
  t3: (q) => `https://t3.chat/new?q=${q}`,
  v0: (q) => `https://v0.app?q=${q}`,
};

const NAMES: Record<ProviderKey, string> = {
  chatgpt: "ChatGPT",
  claude: "Claude",
  codex: "Codex",
  cursor: "Cursor",
  scira: "Scira",
  t3: "T3 Chat",
  v0: "v0",
};

/** Monochrome brand marks, matching Blume's own page-action menu. */
const LOGOS: Record<ProviderKey, string> = {
  chatgpt:
