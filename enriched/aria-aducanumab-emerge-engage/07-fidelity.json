      "critical": false,
      "builder_quote_located": true,
      "critic_quote_located": true
    },
    {
      "field": "study.followup",
      "builder": "Monthly intravenous doses over 76 weeks for a total of 20 doses (placebo-controlled period); postbaseline routine MRIs at weeks 14, 22, 30, 42, 54, 66, and 78",
      "critic": "76 weeks for a total of 20 doses",
      "agree": true,
      "kind": "agree",
      "critical": false,
      "builder_quote_located": true,
      "critic_quote_located": true
    },
    {
      "field": "study.intervention",
      "builder": "Intravenous aducanumab, high dose or low dose, once every 4 weeks, with dose titration; high-dose target 10 mg/kg (titrated from 1 to 3 to 6 to 10 mg/kg over 24 weeks) from protocol version 4; low dose 3 mg/kg in ApoE ε4 carriers or 6 mg/kg in noncarriers",
      "critic": "high-dose or low-dose intravenous aducanumab",
      "agree": true,
