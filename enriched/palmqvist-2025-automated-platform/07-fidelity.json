      "field": "study.design",
      "builder": "Multi-cohort diagnostic accuracy validation of plasma p-tau217 using predefined biomarker cutoffs established in one secondary care cohort (Malmö) and then applied to four independent out-of-sample cohorts, four in secondary care and one in primary care",
      "critic": "independent secondary care cohorts and a primary care cohort",
      "agree": true,
      "kind": "agree",
      "critical": true,
      "builder_quote_located": true,
      "critic_quote_located": true
    },
